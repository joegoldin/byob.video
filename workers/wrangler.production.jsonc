{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "byob-video",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/session/*",
      "/socket/*",
      "/live/*",
      "/extension/*",
      "/health",
      "/__test/*"
    ]
  },
  "send_metrics": false,
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      },
      {
        "name": "POOL",
        "class_name": "VideoPool"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Room"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "VideoPool"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "CREATE_LIMITER",
      "namespace_id": "4101",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "API_READ_LIMITER",
      "namespace_id": "4102",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "API_MUTATE_LIMITER",
      "namespace_id": "4103",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "JOIN_LIMITER",
      "namespace_id": "4104",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "routes": [
    {
      "pattern": "byob.video/*",
      "zone_name": "byob.video"
    },
    {
      "pattern": "www.byob.video/*",
      "zone_name": "byob.video"
    }
  ]
}
